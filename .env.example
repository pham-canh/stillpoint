# Copy to .env and fill in. Never commit .env.
SMARTSPECTRA_API_KEY=

# Local HTTP port. The server binds to loopback only.
PORT=4317

# Capture mode: camera (native SDK, default) or frames (browser fallback).
# CAPTURE_MODE=camera
# CAMERA_ID=            # from SmartSpectraSDK.availableCameras(); default = first camera
# CAMERA_WIDTH=1280
# CAMERA_HEIGHT=720
# CAMERA_FPS=30

# Optional: run the UI against a recorded clip instead of a camera.
# The clip is fed through the same SmartSpectra pipeline with useFile().
# DEMO_VIDEO=./test-assets/face.mp4

# Optional timing overrides (milliseconds).
# SESSION_MS=90000
# SETTLE_MS=32000
